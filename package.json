{
	"name": "springy-cursor",
	"displayName": "Springy Cursor",
	"description": "Neovide-like animated cursor trail for VS Code",
	"version": "0.1.0",
	"publisher": "tqsy",
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"cursor",
		"animation",
		"neovide",
		"trail",
		"smear"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"extensionDependencies": [
		"be5invis.vscode-custom-css"
	],
	"contributes": {
		"commands": [
			{
				"command": "springyCursor.enable",
				"title": "Enable / Update Cursor Trail",
				"category": "Springy Cursor"
			},
			{
				"command": "springyCursor.disable",
				"title": "Disable Cursor Trail",
				"category": "Springy Cursor"
			}
		],
		"configuration": {
			"title": "Springy Cursor",
			"properties": {
				"springyCursor.color": {
					"type": "string",
					"default": "#FFC0CB",
					"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
					"description": "Trail color as #RGB, #RRGGBB or #RRGGBBAA."
				},
				"springyCursor.opacity": {
					"type": "number",
					"default": 1,
					"minimum": 0,
					"maximum": 1,
					"description": "Trail opacity."
				},
				"springyCursor.glow": {
					"type": "boolean",
					"default": true,
					"description": "Draw a glow around the trail (costs some performance)."
				},
				"springyCursor.glowBlur": {
					"type": "number",
					"default": 0.5,
					"minimum": 0,
					"description": "Glow blur radius as a multiple of the cursor size."
				},
				"springyCursor.animationLength": {
					"type": "number",
					"default": 0.125,
					"minimum": 0.01,
					"description": "Animation length in seconds for cursor jumps."
				},
				"springyCursor.shortAnimationLength": {
					"type": "number",
					"default": 0.05,
					"minimum": 0.01,
					"description": "Animation length in seconds for short moves on the same line, such as typing."
				}
			}
		}
	}
}
